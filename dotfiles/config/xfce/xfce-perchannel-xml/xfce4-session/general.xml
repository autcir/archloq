<?xml version="1.0" encoding="UTF-8"?>
<!-- xfce4-session: save window positions on logout, but do not restore a
     crashed application on the next login. Autostart is pruned to nothing: the
     defaults pull in notification and mixer daemons that duplicate the ones
     xfce4-session already starts. -->
<channel name="xfce4-session" version="1.0">
  <property name="general" type="empty">
    <property name="FailsafeSessionName" type="string" value="Failsafe"/>
    <property name="SaveOnExit" type="bool" value="true"/>
    <property name="AutoSave" type="bool" value="false"/>
  </property>
  <property name="shutdown" type="empty">
    <property name="ShowHibernate" type="bool" value="false"/>
    <property name="ShowHybridSleep" type="bool" value="false"/>
    <property name="ShowSuspend" type="bool" value="true"/>
  </property>
  <property name="compat" type="empty">
    <property name="LaunchGNOME" type="bool" value="false"/>
    <property name="LaunchKDE" type="bool" value="false"/>
  </property>
</channel>
