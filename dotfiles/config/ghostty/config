# Ghostty config — Catppuccin Mocha
# GPU-accelerated terminal per Wayland/X11
# Eye-care: trasparenza morbida + blur KWin, contrasto preservato.
# Palette: https://catppuccin.com/palette/ (Mocha)

# --- Font -------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 9.5
font-feature = calt
font-feature = liga
adjust-cell-height = 10%

# --- Catppuccin Mocha palette ----------------------------------------------
background = #1e1e2e
foreground = #cdd6f4

# Normal colors
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de

# Bright colors
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# --- Cursor -----------------------------------------------------------------
cursor-color = #f5e0dc
cursor-text = #1e1e2e
cursor-style-blink = true

# --- Selection --------------------------------------------------------------
selection-background = #585b70
selection-foreground = #cdd6f4

# --- Trasparenza + blur (eye-care) ------------------------------------------
# 0.88 = soffice, leggibile, si vede il wallpaper senza stancare.
background-opacity = 0.85
background-blur = true

# --- Window -----------------------------------------------------------------
window-padding-x = 8
window-padding-y = 8
window-padding-color = extend
window-decoration = auto
window-theme = dark
window-title-font-family = JetBrainsMono Nerd Font
window-vsync = true

# --- Shell ------------------------------------------------------------------
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- UI ---------------------------------------------------------------------
scrollbar = never
window-show-tab-bar = never
copy-on-select = true
mouse-hide-while-typing = true
