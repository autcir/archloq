{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cliphist",
        "pulseaudio",
        "network",
        "battery",
        "cpu",
        "memory",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },
    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%A %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip-format": "CPU: {usage}%\nLoad: {load}",
        "interval": 2
    },
    "memory": {
        "format": " {}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G",
        "interval": 2
    },
    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "pavucontrol",
        "tooltip-format": "Volume: {volume}%"
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": " {capacity}%",
        "format-charging": " ",
        "format-full": " ",
        "format-warning": " {capacity}%",
        "format-critical": " {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo}\nPower: {power}W"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "cliphist": {
        "format": " ",
        "exec": "cliphist list",
        "on-click": "cliphist list | rofi -dmenu | cliphist decode | wl-copy",
        "tooltip": true
    },
    "custom/power": {
        "format": " ",
        "on-click": "wlogout",
        "tooltip": false
    }
}
