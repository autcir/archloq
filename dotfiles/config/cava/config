# cava config — Catppuccin Mocha
# Audio visualizer con palette Mocha

[general]
bars = 0
bar_width = 2
bar_spacing = 1
bar_height = 32
framerate = 60
noise_reduction = 0.77

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit
mono_option = average
reverse = 0
ascii_max_range = 1000

[color]
; Catppuccin Mocha gradient: teal → mauve → pink
gradient = 1
gradient_count = 8
gradient_color_1 = '#94e2d5'
gradient_color_2 = '#89b4fa'
gradient_color_3 = '#74c7ec'
gradient_color_4 = '#cba6f7'
gradient_color_5 = '#f5c2e7'
gradient_color_6 = '#f38ba8'
gradient_color_7 = '#fab387'
gradient_color_8 = '#f9e2af'

[smoothing]
integral = 77
monstercat = 1.5
waves = 0
gravity = 100
